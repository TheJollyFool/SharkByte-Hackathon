{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "roadmap.schema.json",
  "title": "Roadmap",
  "description": "Contract between backend and frontend. Change only with team agreement and update fixtures + both sides.",
  "type": "object",
  "required": [
    "career",
    "routes"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "source": {
      "enum": [
        "live",
        "cache",
        "fallback"
      ]
    },
    "mode": {
      "enum": [
        "group_chat",
        "mixture"
      ],
      "description": "Which mode produced the conversation"
    },
    "language": {
      "enum": [
        "en",
        "es"
      ]
    },
    "career": {
      "type": "object",
      "required": [
        "title",
        "overview"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "overview": {
          "type": "string"
        },
        "responsibilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "qualifications": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "median_salary_usd": {
          "type": [
            "number",
            "null"
          ]
        },
        "outlook": {
          "type": [
            "string",
            "null"
          ]
        },
        "related_careers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/route"
      }
    },
    "alternative_mdc_programs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "program_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "usage": {
      "type": "object",
      "properties": {
        "total_tokens": {
          "type": "integer"
        },
        "total_cost_usd": {
          "type": "number"
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Shown on top of the flowchart, e.g. limited-access majors, estimated data"
    }
  },
  "$defs": {
    "route": {
      "type": "object",
      "required": [
        "id",
        "name",
        "type",
        "steps",
        "total_months",
        "total_cost_usd"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "enum": [
            "short",
            "medium",
            "long"
          ]
        },
        "summary": {
          "type": "string"
        },
        "total_months": {
          "type": "number"
        },
        "total_cost_usd": {
          "type": "number"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "workforce_entry_points": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "after_step",
              "job_title"
            ],
            "properties": {
              "after_step": {
                "type": "integer",
                "description": "Index into steps (0-based)"
              },
              "job_title": {
                "type": "string"
              },
              "salary_range_usd": {
                "type": "string"
              }
            }
          }
        },
        "credentials": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/credential"
          }
        },
        "experience": {
          "type": "array",
          "description": "Internships, apprenticeships, work experience",
          "items": {
            "type": "string"
          }
        },
        "exams": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "net_cost_after_aid_usd": {
          "type": [
            "number",
            "null"
          ],
          "description": "Estimated cost after typical aid (Pell, Bright Futures). Always an estimate."
        }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "id",
        "order",
        "kind",
        "institution",
        "credential",
        "duration_months",
        "cost_usd"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique in the roadmap, e.g. 'short-0'. Used by the flowchart and the in-page guide (goal.step_id)."
        },
        "order": {
          "type": "integer"
        },
        "institution": {
          "type": "string",
          "description": "First step must be Miami Dade College"
        },
        "program_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "id from data/mdc_programs.json when MDC"
        },
        "credential": {
          "type": "string",
          "description": "e.g. College Credit Certificate, A.S., A.A., B.S., M.S."
        },
        "program_name": {
          "type": "string"
        },
        "duration_months": {
          "type": "number"
        },
        "cost_usd": {
          "type": "number"
        },
        "estimate": {
          "type": "boolean"
        },
        "transfer_agreement": {
          "type": [
            "string",
            "null"
          ]
        },
        "key_courses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "enum": [
            "mdc_program",
            "certification",
            "exam",
            "internship",
            "transfer",
            "degree",
            "other"
          ],
          "description": "Box type in the flowchart"
        }
      }
    },
    "credential": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "enum": [
            "certification",
            "license",
            "degree",
            "other"
          ]
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "resource": {
      "type": "object",
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "exam_prep",
            "resume",
            "interview",
            "financial_aid",
            "other"
          ]
        }
      }
    }
  }
}
