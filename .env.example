# --- Backend (only the backend reads these; never put keys in frontend/ or extension/) ---
SWARMS_API_KEY=
SWARMS_BASE_URL=https://api.swarms.world
# Model per agent. Check valid names with: GET /v1/models/available
MODEL_CAREER=gpt-5.4-mini
MODEL_PATHWAY=gpt-5.4-mini
MODEL_COST=gpt-5.4-mini
MODEL_FINAID=gpt-5.4-mini
MODEL_PRODEV=gpt-5.4-mini
MODEL_ALTERNATIVES=gpt-5.4-mini
MODEL_AGGREGATOR=gpt-5.4-mini
MODEL_WRITER=gpt-5.4-mini
MODEL_NAVIGATOR=gpt-5.4-mini
MAX_TOKENS_CHAT=300
MAX_TOKENS_AGGREGATOR=600
MAX_TOKENS_WRITER=4000
MAX_TOKENS_NAVIGATOR=200
# true = serve only cache/fixtures, never call Swarms (safe demo / no credits)
DEMO_MODE=false
CACHE_DIR=.cache
CORS_ORIGINS=http://localhost:3000

# --- Panel app (frontend) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCK=true

# --- Extension (set in extension/config.ts, not read from here) ---
# PANEL_ORIGIN=http://localhost:3000
# API_URL=http://localhost:8000
# MOCK_NAVIGATE=true
