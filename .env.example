# --- Backend ---
SWARMS_API_KEY=
SWARMS_BASE_URL=https://api.swarms.world
# Model per agent. Check valid names with: GET /v1/models/available
# Use a cheap model while developing; switch to a Gemini model for the Gemini prize if available.
MODEL_RESEARCHER=gpt-5.4-mini
MODEL_PROGRAM_FINDER=gpt-5.4-mini
MODEL_COST_ANALYST=gpt-5.4-mini
MODEL_PLANNER=gpt-5.4-mini
MODEL_WRITER=gpt-5.4-mini
MAX_TOKENS_PER_AGENT=4000
# true = return cached fixtures instead of calling Swarms (safe demo / no credits)
DEMO_MODE=false
CACHE_DIR=.cache/roadmaps
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCK=true
