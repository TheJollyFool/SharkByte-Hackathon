# --- Backend (only the backend reads these; never put keys in frontend/ or extension/) ---
SWARMS_API_KEY=
SWARMS_BASE_URL=https://api.swarms.world
# Model per agent (a different model per advisor is the point of the demo). Avoid claude-sonnet-5-5 / opus-4-7 (reject temperature), DeepSeek and Grok. Gemini uses thinking tokens, so keep MAX_TOKENS_CHAT >= 700.
MODEL_CAREER=gemini/gemini-2.5-flash
MODEL_PATHWAY=claude-sonnet-4-6
MODEL_COST=gpt-5.4
MODEL_FINAID=gpt-5.5
MODEL_PRODEV=claude-haiku-4-5
MODEL_ALTERNATIVES=gpt-5.4-mini
MODEL_AGGREGATOR=claude-sonnet-4-6
MODEL_WRITER=gpt-5.4
MODEL_NAVIGATOR=gpt-5.4-mini
MAX_TOKENS_CHAT=700
MAX_TOKENS_AGGREGATOR=600
MAX_TOKENS_WRITER=4000
MAX_TOKENS_NAVIGATOR=200
# true = serve only cache/fixtures, never call Swarms (safe demo / no credits)
DEMO_MODE=false
CACHE_DIR=.cache
CORS_ORIGINS=http://localhost:3000

# --- Panel app (frontend) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCK=true

# --- Extension (set in extension/config.ts, not read from here) ---
# PANEL_ORIGIN=http://localhost:3000
# API_URL=http://localhost:8000
# MOCK_NAVIGATE=true
